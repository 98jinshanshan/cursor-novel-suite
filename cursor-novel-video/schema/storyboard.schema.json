{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NovelVideoStoryboard",
  "type": "object",
  "required": ["job_id", "source_chapter", "mode", "scenes"],
  "properties": {
    "job_id": { "type": "string" },
    "source_chapter": { "type": "string" },
    "novel": {
      "type": "object",
      "properties": {
        "slug": { "type": "string" },
        "title": { "type": "string" },
        "project": { "type": "string" },
        "chapter": { "type": "string" },
        "in_registry": { "type": "boolean" }
      }
    },
    "mode": { "type": "string", "enum": ["summary", "drama"] },
    "aspect": { "type": "string", "enum": ["9:16", "16:9", "1:1"], "default": "9:16" },
    "target_duration_sec": { "type": "integer", "minimum": 30 },
    "voice": { "type": "string", "default": "zh-CN-XiaoxiaoNeural" },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "narration"],
        "properties": {
          "id": { "type": "string" },
          "narration": { "type": "string" },
          "visual_job": {
            "type": "string",
            "enum": ["proof", "mechanism", "consequence", "action", "transition"]
          },
          "duration_target": { "type": "number" },
          "asset": { "type": "string" }
        }
      }
    }
  }
}
