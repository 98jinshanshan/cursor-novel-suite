# ===== 必需凭据（请勿提交到 Git） =====
# Copy to .env and fill locally — never commit .env

## Monorepo root (optional)
# NOVEL_SUITE_ROOT=G:/CURSOR

## 嵌入模型后端：hash（CI/离线）或 m3e（生产）
MEMORY_EMBED_BACKEND=m3e
MEMORY_EMBED_MODEL=moka-ai/m3e-base

## Qdrant 向量数据库（仅本机 127.0.0.1）
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=

## LLM 服务（预留）
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=

## 硅基流动（SiliconFlow — 本地保存，勿提交）
# 运行: powershell -File platforms/save-local-secret.ps1 -Provider siliconflow
# 或手动: SILICONFLOW_API_KEY=sk-...（仅本机 .env，勿 commit）
# SILICONFLOW_API_KEY=

## 火山方舟 Agent Plan
# ARK_API_KEY=

## Ollama 本地模型（绑定 localhost）
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:14b
# GEMMA_QC_MODEL=llava:latest

## ComfyUI（绑定 localhost）
COMFYUI_URL=http://127.0.0.1:8000
COMFYUI_ROOT=G:/ComfyUI
COMFYUI_STILL_BACKEND=wan

# ===== 运行模式 =====
NOVEL_SUITE_ALLOW_SKIP_GATE=0
LOG_LEVEL=info

# ===== 平台发布 Cookie（预留，加密存储 — Sprint 3） =====
# DOUYIN_COOKIE_PATH=./data/cookies/douyin.enc
