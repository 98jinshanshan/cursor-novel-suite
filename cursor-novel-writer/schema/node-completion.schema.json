{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cursor-novel-suite.local/schema/node-completion.schema.json",
  "title": "NodeCompletionManifest",
  "type": "object",
  "required": [
    "schema_version",
    "phase",
    "skill",
    "status",
    "subtasks"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "phase": { "type": "integer", "minimum": 0, "maximum": 9 },
    "skill": { "type": "string", "minLength": 1 },
    "period_id": { "type": "string" },
    "project_slug": { "type": "string" },
    "status": { "type": "string", "enum": ["pending", "partial", "complete", "failed"] },
    "started_at": { "type": "string" },
    "completed_at": { "type": "string" },
    "chat_summary": { "type": "string" },
    "artifacts": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": "string" },
          { "type": "array", "items": { "type": "string" } }
        ]
      }
    },
    "subtasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "executor", "status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^P[0-9]+[a-z]?-S[0-9]+$" },
          "title": { "type": "string" },
          "executor": { "type": "string", "enum": ["cli", "agent", "hybrid"] },
          "command": { "type": "string" },
          "reference": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["pending", "done", "skipped", "failed"]
          },
          "output_paths": {
            "type": "array",
            "items": { "type": "string" }
          },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
